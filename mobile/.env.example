EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional. Street search already works without this.
# Real Google Places needs a Visa/Mastercard on Google Cloud billing.
# If you later get a key: enable Places API (New) + Geocoding API, then paste it here.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Carto Basemaps for the Home map tiles. GPS still works without this.
EXPO_PUBLIC_CARTO_API_KEY=
