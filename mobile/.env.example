EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional. NOT required for live GPS (the phone GPS does that).
# If set, passenger/client search uses Google Places for streets across Nigeria.
# In Google Cloud: enable Places API + Geocoding API, restrict the key, then paste it here.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Carto Basemaps for the Home map tiles. GPS still works without this.
EXPO_PUBLIC_CARTO_API_KEY=
