EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional for Expo Go (maps use Expo's key). Required for custom Android/iOS builds.
# Enable Maps SDK for Android + Maps SDK for iOS in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Carto Basemaps (Voyager tiles on Passenger Home / RouteMap). Do not commit real keys.
EXPO_PUBLIC_CARTO_API_KEY=
