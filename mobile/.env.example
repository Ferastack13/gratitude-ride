EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional. Makes street search feel like Google Maps (Places autocomplete).
# Get a key: https://console.cloud.google.com/google/maps-apis
# Enable: Places API (and Geocoding API). Create Credentials → API key.
# Paste below, save, then restart Expo (npx expo start --lan --clear).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Carto Basemaps for the Home map tiles. GPS still works without this.
EXPO_PUBLIC_CARTO_API_KEY=
